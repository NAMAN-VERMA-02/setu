# Which college this node serves: ngit | rce
COLLEGE_ID=ngit
COLLEGE_NAME=Northgate Institute of Technology
COLLEGE_CITY=Delhi

# Secrets (generate long random values in production; the dev defaults are insecure)
NODE_SECRET=change-me-node-secret      # keys the pseudonyms: pid = <college>_ + HMAC-SHA256(NODE_SECRET, local_id)[:12]
HUB_TOKEN=change-me-hub-token          # Bearer token the hub sends
VIEWER_SECRET=change-me-viewer-secret  # shared with the hub, signs viewer tokens
MCP_TOKEN=change-me-mcp-token          # Bearer token for /mcp
ADMIN_PASSWORD=change-me-admin         # console at /admin

# Browser access (CORS). Hub origin is always allowed; NODE_DEV=1 also allows localhost:3000 and :3001
HUB_ORIGIN=http://localhost:3000
NODE_DEV=1
PUBLIC_URL=http://localhost:8001

DB_PATH=./setu.db
# TRUST_PROXY=1   # rate-limit on the first X-Forwarded-For entry (set when behind a proxy)
